DATABASE_URL=postgres://entellix:change-me@127.0.0.1:5432/entellix
ENTELLIX_LOCAL_TOKEN=replace-with-at-least-24-random-characters
ANTHROPIC_API_KEY=
ENTELLIX_GENERATION_MODEL=claude-haiku-4-5-20251001
ENTELLIX_API_URL=http://localhost:4211
ENTELLIX_MASTRA_SCHEMA=entellix_mastra
ENTELLIX_WORKER_INTERVAL_MS=2000
ENTELLIX_WORKER_BATCH_SIZE=10
ENTELLIX_RAW_RETENTION_DAYS=30

# Optional embedding provider. Without it, retrieval uses PostgreSQL full-text search.
ENTELLIX_EMBEDDING_URL=https://api.voyageai.com/v1/embeddings
ENTELLIX_EMBEDDING_API_KEY=
ENTELLIX_EMBEDDING_MODEL=voyage-4
