{
  "name": "@entellix/standalone",
  "version": "0.1.3",
  "private": true,
  "description": "Single-workspace self-hosted Entellix MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "mastra build",
    "dev": "tsx scripts/dev.ts",
    "migrate": "tsx scripts/migrate.ts",
    "start": "node .mastra/output/index.mjs",
    "test": "pnpm run test:unit",
    "test:integration": "node -e \"console.log('No integration tests for @entellix/standalone; durable storage is covered by the release verification gate.')\"",
    "test:unit": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@entellix/contracts": "workspace:*",
    "@entellix/core": "workspace:*",
    "@entellix/instructions": "workspace:*",
    "@mastra/core": "catalog:",
    "@mastra/mcp": "catalog:",
    "@mastra/pg": "catalog:",
    "ai": "catalog:",
    "effect": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "mastra": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
