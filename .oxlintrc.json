{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import", "vitest", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.mastra/**",
    "**/.react-router/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/node_modules/**",
    ".research-notes/**",
    "plan/**",
    "research/**",
    "docs/**"
  ]
}
